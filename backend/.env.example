# Copiar como .env y ajustar
ENVIRONMENT=development

# PostgreSQL (recomendado). Con docker compose: usuario/clave/base = impulso
DATABASE_URL=postgresql+psycopg://impulso:impulso@localhost:5432/impulso
# Respaldo sin Postgres:
# DATABASE_URL=sqlite:///./impulso_dev.db

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR-ESTA-CLAVE-EN-PRODUCCION
ACCESS_TOKEN_EXPIRE_MINUTES=480

FIRST_ADMIN_EMAIL=admin@impulsodigital.co
FIRST_ADMIN_PASSWORD=Admin123*

CONVERSION_TARGET=0.24
PRIVACY_POLICY_VERSION=2026-01
